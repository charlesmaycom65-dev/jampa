{
  "rules": {
    ".read": false,
    ".write": false,
    "votos": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['nome', 't'])",
        "nome": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24" },
        "t": { ".validate": "newData.isNumber()" },
        "dias": {
          "$dia": {
            ".validate": "$dia.matches(/^[1-7]$/)",
            "$lugar": { ".validate": "$lugar.matches(/^[pltan][0-9]{1,2}$/) && newData.val() === true" }
          }
        },
        "$outro": { ".validate": false }
      }
    }
  }
}
